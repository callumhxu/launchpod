    "After quitting, keyboard shortcuts and the menu bar will be unavailable. Open Launchpod again to use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Beenden sind die Tastaturkurzbefehle und der Menüleisteneintrag nicht mehr verfügbar. Öffne Launchpod erneut, um es wieder zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir, los atajos de teclado y el acceso desde la barra de menús dejarán de estar disponibles. Vuelve a abrir Launchpod para usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir quitté Launchpod, les raccourcis clavier et l’accès depuis la barre des menus ne seront plus disponibles. Rouvrez Launchpod pour l’utiliser à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了すると、キーボードショートカットとメニューバーからはアクセスできなくなります。再び使用するには、Launchpodを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료하면 키보드 단축키와 메뉴 막대를 사용할 수 없습니다. 다시 사용하려면 Launchpod을 다시 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出后，快捷键和菜单栏入口将不可用。再次使用需重新打开 Launchpod。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束後，鍵盤快速鍵和選單列入口將無法使用。若要再次使用，請重新開啟 Launchpod。"
          }
        }
      }
    },
