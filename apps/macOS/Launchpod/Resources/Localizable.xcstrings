    "Browse your apps in Classical mode, search by name, and keep them together in folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsuche deine Apps im klassischen Modus nach Namen und ordne sie in Ordnern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora tus apps en el modo Clásico, búscalas por nombre y organízalas en carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez vos apps en mode Classique, recherchez-les par nom et regroupez-les dans des dossiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラシックモードでアプリを一覧し、名前で検索したり、フォルダに整理したりできます。"
          }
        },
        "ko" : {
