    "Your current Classical layout will be replaced. Export a backup first if you want to keep it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr aktuelles klassisches Layout wird ersetzt. Exportieren Sie zuvor eine Sicherung, wenn Sie es behalten möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reemplazará el diseño clásico actual. Exporta una copia si quieres conservarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre disposition classique actuelle sera remplacée. Exportez une sauvegarde pour la conserver."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のクラシックのレイアウトは置き換えられます。残す場合は先にバックアップを書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 클래식 레이아웃이 바뀝니다. 보관하려면 먼저 백업을 내보내세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前经典模式布局将被替换。如需保留，请先导出备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的經典模式佈局將被取代。如要保留，請先匯出備份。"
          }
        }
      }
    },
    "Your saved Classical icon positions and folders will be removed. App sources and other settings stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Symbolpositionen und Ordner des klassischen Modus werden entfernt. App-Quellen und andere Einstellungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán las posiciones de iconos y carpetas guardadas del modo clásico. Las fuentes de apps y otros ajustes permanecerán igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les positions et dossiers enregistrés du mode classique seront supprimés. Les sources d’apps et les autres réglages resteront inchangés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのクラシックのアイコン位置とフォルダは削除されます。アプリの追加元やその他の設定は維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 클래식 아이콘 위치와 폴더가 제거됩니다. 앱 소스와 다른 설정은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的经典模式图标位置和文件夹将被移除。应用来源及其他设置保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的經典模式圖示位置及資料夾將被移除。App 來源及其他設定維持不變。"
          }
        }
      }
    }
