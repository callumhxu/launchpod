    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launchpod asks Finder to move the applications you delete to the Trash."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpod bittet den Finder, die Apps, die du löschst, in den Papierkorb zu legen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpod pide al Finder que traslade a la Papelera las apps que eliminas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpod demande au Finder de placer dans la Corbeille les apps que vous supprimez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpod は、削除したアプリケーションをゴミ箱に入れるよう Finder に依頼します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpod는 삭제한 앱을 휴지통으로 이동하도록 Finder에 요청합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpod 会请访达把你删除的应用程序移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpod 會請 Finder 將你刪除的應用程式移到垃圾桶。"
          }
        }
      }
    }
  },
  "version" : "1.0"
