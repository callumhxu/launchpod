# Release build settings for GitHub Actions (.github/workflows/release-macos.yml).
# Copy to .env and fill in; .env is ignored by Git.

# Signing identity, kept as Actions secrets so logs mask it (Settings > Secrets and variables > Actions > Secrets).
# Sparkle update-signing public key, Base64 output of Sparkle generate_keys.
SPARKLE_PUBLIC_ED_KEY=
# Apple Developer team ID; 10 alphanumeric characters.
APPLE_TEAM_ID=
# Exact signing certificate name, e.g. Developer ID Application: Company (TEAMID).
DEVELOPER_ID_APPLICATION=

# Actions secrets (Settings > Secrets and variables > Actions > Secrets).
# Base64 of the exported Developer ID certificate with its private key (.p12).
DEVELOPER_ID_CERTIFICATE_BASE64=
# Password used when exporting that .p12 file.
DEVELOPER_ID_CERTIFICATE_PASSWORD=
# Base64 of the App Store Connect API .p8 private key.
APPLE_API_KEY_P8_BASE64=
# Key ID and issuer UUID from App Store Connect > Users and Access > Integrations.
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
# Sparkle private key matching SPARKLE_PUBLIC_ED_KEY.
SPARKLE_PRIVATE_ED_KEY=
# GitHub token with Contents: write on the Homebrew tap repository.
HOMEBREW_TAP_TOKEN=
